{
  "name": "fibercad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "type-check": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "node --test tests/*.test.ts tests/*.test.js",
    "test:browser": "node tests/browser/freestyle-visual.mjs",
    "validate": "tsc --noEmit && node scripts/lint.mjs && node --test tests/*.test.ts tests/*.test.js && vite build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "playwright": "^1.53.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0"
  }
}
